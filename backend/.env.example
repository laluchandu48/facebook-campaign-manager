PORT=5000
NODE_ENV=development

# Facebook app (developers.facebook.com -> your app -> Settings -> Basic)
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# Where the frontend and backend run. Used for CORS and the Facebook login redirect.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Set to "none" (with HTTPS) only if frontend and backend are on different domains.
COOKIE_SAMESITE=lax
